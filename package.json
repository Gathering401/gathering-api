{
  "name": "gathering-api",
  "version": "1.0.0",
  "description": "API to source all data for the Gathering web app",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "esbuild src/app.ts --bundle --platform=node --packages=external --outfile=dist/app.js --sourcemap",
    "start": "npm run build && node dist/app.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "knex_reset": "knex migrate:rollback && knex migrate:latest && knex seed:run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gathering401/gathering-api.git"
  },
  "keywords": [],
  "author": "",
