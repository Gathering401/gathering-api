  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Gathering401/gathering-api/issues"
  },
  "homepage": "https://github.com/Gathering401/gathering-api#readme",
  "dependencies": {
    "@types/knex": "^0.15.2",
    "@types/node": "^25.4.0",
    "@types/pg": "^8.18.0",
    "@types/yup": "^0.29.14",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "esbuild": "^0.27.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "lodash": "^4.17.23",
    "pg": "^8.20.0",
    "typescript": "^5.9.3",
    "yup": "^1.7.1"
  },
